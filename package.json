{
  "name": "workie-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Workie — desktop app (Electron shell around the Workie web app)",
  "author": "Umberto",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --mac dmg",
    "release": "electron-builder --mac dmg --publish always"
  },
  "build": {
    "appId": "app.workie.desktop",
    "productName": "Workie",
    "publish": [
      {
        "provider": "github",
        "owner": "umagaretti",
        "repo": "workie-desktop"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "index.html",
      "css/**/*",
      "api.js",
      "i18n.js",
      "dates.js",
      "themes.js",
      "storage.js",
      "app.js",
      "*.svg",
      "*.png",
      "manifest.webmanifest",
      "sw.js",
      "_headers"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": null,
      "target": [
        "dmg"
      ]
    }
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
